rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function isServant() { return signedIn() && exists(/databases/$(db)/documents/admins/$(request.auth.uid)); }
    function okUser(d) {
      return d.keys().hasOnly(['name','phone','uids','readDays','readAt','quiz','createdAt','lastSeen'])
        && d.name is string && d.name.size() >= 2 && d.name.size() <= 40
        && d.readDays is list && d.readDays.size() <= 46;
    }
    match /users/{phone} {
      allow read: if signedIn();
      allow create: if signedIn() && phone.matches('^01[0125][0-9]{8}$')
        && request.resource.data.phone == phone && okUser(request.resource.data);
      allow update: if signedIn() && okUser(request.resource.data)
        && request.resource.data.phone == resource.data.phone;
      allow delete: if isServant();
    }
    match /days/{day} { allow read: if signedIn(); allow write: if isServant(); }
    match /chq/{key} { allow read: if signedIn(); allow write: if isServant(); }
    match /exams/{id} { allow read: if signedIn(); allow write: if isServant(); }
    match /examKeys/{id} { allow read, write: if isServant(); }
    match /submissions/{sid} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && sid == request.resource.data.examId + '_' + request.resource.data.phone
        && get(/databases/$(db)/documents/exams/$(request.resource.data.examId)).data.status == 'open';
      allow read: if isServant() || (signedIn() && resource.data.uid == request.auth.uid);
      allow delete: if isServant();
    }
    match /wall/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && request.resource.data.type in ['verse','prayer']
        && request.resource.data.text is string && request.resource.data.text.size() <= 400
        && request.resource.data.prayed == 0;
      allow update: if signedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['prayed'])
        && request.resource.data.prayed == resource.data.prayed + 1;
      allow delete: if isServant() || (signedIn() && resource.data.uid == request.auth.uid);
    }
    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.code == get(/databases/$(db)/documents/secrets/servants).data.code;
    }
    match /secrets/servants {
      allow read: if false;
      allow create: if signedIn() && request.resource.data.code is string && request.resource.data.code.size() >= 4;
    }
  }
}
